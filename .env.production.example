# HelmUI production build configuration.
# Copy to .env.production (or export these before `npm run build`).

VITE_RUNTIME_PROFILE=production-live
VITE_TELEMETRY_TRANSPORT=bridge
VITE_TELEMETRY_BRIDGE_WS_URL=ws://127.0.0.1:4300/ws
VITE_TELEMETRY_BRIDGE_HTTP_URL=http://127.0.0.1:4300

# Offline chart layer (served by the web server from dist/tiles or the bridge)
VITE_CHART_OFFLINE_ONLY=true
VITE_CHART_TILE_URL_TEMPLATE=/tiles/base.svg

VITE_AI_ASSISTANT_ENABLED=false

# Bridge MQTT topics for a physical brightness knob and autopilot sentences (via Node-RED)
# BRIDGE_MQTT_BRIGHTNESS_TOPIC=helmui/kiosk/brightness
# BRIDGE_MQTT_AUTOPILOT_STATE_TOPIC=helmui/autopilot/state
# BRIDGE_MQTT_AUTOPILOT_HEADING_TOPIC=helmui/autopilot/heading
# Outbound autopilot control commands published by the UI (POST /command on the
# bridge) as <prefix>/{state,heading,adjust,tack,advance}. Map these in Node-RED.
# BRIDGE_MQTT_AUTOPILOT_COMMAND_PREFIX=helmui/autopilot/command

# Optional bench replay (skips live Signal K/MQTT). Do not set on the boat.
# BRIDGE_REPLAY_FILE=backend/bridge/fixtures/bench-pass.json

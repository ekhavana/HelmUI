BRIDGE_PORT=4300
BRIDGE_SIGNALK_WS_URL=ws://127.0.0.1:3000/signalk/v1/stream?subscribe=none
BRIDGE_MQTT_URL=mqtt://127.0.0.1:1883
BRIDGE_MQTT_STATUS_TOPIC=helmui/bridge/nodered/status
BRIDGE_MQTT_BRIGHTNESS_TOPIC=helmui/kiosk/brightness
BRIDGE_MQTT_AUTOPILOT_STATE_TOPIC=helmui/autopilot/state
BRIDGE_MQTT_AUTOPILOT_HEADING_TOPIC=helmui/autopilot/heading
# Outbound autopilot commands from the UI are published as
# <prefix>/{state,heading,adjust,tack,advance} for Node-RED to act on.
BRIDGE_MQTT_AUTOPILOT_COMMAND_PREFIX=helmui/autopilot/command
# Bench only — leave unset on the vessel:
# BRIDGE_REPLAY_FILE=/opt/helmui/backend/bridge/fixtures/bench-pass.json

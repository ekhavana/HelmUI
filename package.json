{
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "bridge": "node backend/bridge/server.mjs",
    "bridge:replay": "BRIDGE_REPLAY_FILE=backend/bridge/fixtures/bench-pass.json node backend/bridge/server.mjs",
    "test": "npm run test:bridge && npm run test:domain",
    "test:bridge": "node --test backend/bridge/tests/*.test.mjs",
    "test:domain": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test src/utils/depth.test.ts src/domain/ais/aggregateAis.test.ts src/domain/alarms/evaluateAlarms.test.ts src/domain/settings/profile.test.ts src/domain/dashboard/layout.test.ts",
    "smoke:bridge": "node scripts/smoke-bridge.mjs",
    "smoke:replay": "node scripts/smoke-replay.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "framer-motion": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "mqtt": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "^8.1.0",
    "ws": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "^1.9.14",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "postcss": "latest",
    "tailwindcss": "latest"
  }
}
